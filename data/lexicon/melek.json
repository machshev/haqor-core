  "doctrine": [
    {
      "topic": "kingdom-given-by-god",
      "statement": "Daniel tells the king that the God of heaven gave him his kingdom (Dan 2:37). The vision later gives enduring dominion and kingdom to one like a son of man, and the kingdom to the people of the holy ones (Dan 7:13–14, 27). Luke announces that Jesus will receive David’s throne and reign over Jacob’s house without end (Luk 1:32–33). In these passages kingship is authority received and exercised, not merely a place-name.",
      "evidence": [
        {
          "ref": "Dan.2.37"
        },
        {
          "ref": "Dan.7.13"
        },
        {
          "ref": "Dan.7.14"
        },
        {
          "ref": "Dan.7.27"
        },
        {
          "ref": "Luk.1.32"
        },
        {
          "ref": "Luk.1.33"
        }
      ]
