  "gloss": "straw; heap of straw",
  "summary": "Straw feeds the camels in Rebekah’s household and the horses supplied for Solomon. When Pharaoh withholds it from his brickmakers, the Israelites scour the fields for stubble to take its place.",
  "words": [
    {
      "lemma": "תֶּבֶן",
      "pos": "noun",
      "gender": "m",
      "bdb": [
        "w.af.aa"
      ],
      "gloss": "straw",
      "senses": [
        {
          "id": "straw",
          "gloss": "straw",
          "definition": "Dry stalks of grain used as animal feed and in brickmaking. Their lightness and their difference from the grain itself furnish comparisons.",
          "evidence": [
            {
              "ref": "Gen.24.32",
              "role": "defining",
              "note": "The camels receive straw and fodder when they are unloaded."
            },
            {
              "ref": "1Ki.5.8",
              "role": "defining",
              "note": "Barley and straw are brought for the horses."
            },
            {
              "ref": "Isa.11.7",
              "role": "defining",
              "note": "The lion eating straw like the ox pictures peace among animals."
            },
            {
              "ref": "Exo.5.7",
              "role": "defining",
              "note": "The workers must now find their own straw for their bricks."
            },
            {
              "ref": "Exo.5.12",
              "role": "defining",
              "note": "They gather קַשׁ, stubble, for use as תֶּבֶן."
            },
            {
              "ref": "Jer.23.28",
              "role": "defining",
              "note": "The question about straw and grain distinguishes a dream from Yahweh’s word."
            },
            {
              "ref": "Job.21.18",
              "role": "defining",
              "note": "Straw before the wind stands alongside chaff carried away by a storm."
            }
          ],
