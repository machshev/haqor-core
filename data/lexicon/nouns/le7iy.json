        {
          "id": "place",
          "gloss": "Lehi",
          "definition": "A place in Judah associated with Samson’s encounter with the Philistines.",
          "evidence": [
            {
              "ref": "Jdg.15.9",
              "role": "defining",
              "note": "The Philistines camp in Judah and spread out at Lehi."
            },
            {
              "ref": "Jdg.15.17",
              "role": "defining",
              "note": "After throwing away the jawbone, Samson calls the place Ramath-lehi."
            },
            {
              "ref": "Jdg.15.19",
              "role": "defining",
              "note": "The narrator locates the spring En-hakkore in Lehi."
            }
          ]
        }
