        {
          "id": "jaw",
          "gloss": "jaw, jawbone",
          "definition": "The bony part of the mouth that bears the teeth, including the bone when detached.",
          "evidence": [
            {
              "ref": "Jdg.15.15",
              "role": "defining",
              "note": "Samson finds a fresh donkey’s jawbone and takes it in his hand."
            },
            {
              "ref": "Deu.18.3",
              "role": "defining",
              "note": "The two jaws of an ox or sheep are included with the shoulder and stomach in the priest’s portion."
            },
            {
              "ref": "Ezk.29.4",
              "role": "defining",
              "note": "Yahweh pictures Pharaoh as a river creature drawn out by hooks set in its jaws."
            }
          ],
