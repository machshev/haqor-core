        {
          "id": "cheek",
          "gloss": "cheek",
          "definition": "The outer side of the face over the jaw.",
          "evidence": [
            {
              "ref": "Lam.1.2",
              "role": "defining",
              "note": "Jerusalem weeps through the night with tears on her cheek."
            },
            {
              "ref": "1Ki.22.24",
              "role": "defining",
              "note": "Zedekiah strikes Micaiah on the cheek as he challenges his prophecy."
            },
            {
              "ref": "Sng.1.10",
              "role": "defining",
              "note": "The beloved’s adorned cheeks are paired with her necklace in a description of her beauty."
            }
