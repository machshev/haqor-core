      "senses": [
        {
          "id": "handmill",
          "gloss": "hand mill, millstones",
          "definition": "A pair of stones used to grind food, named together in the dual.",
          "evidence": [
            {
              "ref": "Num.11.8",
              "role": "defining",
              "note": "The people can grind manna in the mill or pound it in a mortar."
            },
            {
              "ref": "Deu.24.6",
              "role": "defining",
              "note": "The law mentions the mill and its upper stone separately in forbidding their seizure."
            },
            {
              "ref": "Exo.11.5",
              "role": "defining",
              "note": "The enslaved woman at the mill stands at the opposite end of the social scale from Pharaoh."
            },
            {
              "ref": "Isa.47.2",
              "role": "defining",
              "note": "Daughter Babylon is told to take the millstones and grind flour."
            },
            {
              "ref": "Jer.25.10",
              "role": "defining",
              "note": "The sound of the millstones ceases along with wedding celebrations and the light of the lamp."
            }
          ],
