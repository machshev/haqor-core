      "senses": [
        {
          "id": "flour",
          "gloss": "flour, meal",
          "definition": "Ground grain used for bread and other food. The grain or grade can be specified separately.",
          "evidence": [
            {
              "ref": "Isa.47.2",
              "role": "defining",
              "note": "Daughter Babylon is told to take millstones and grind flour."
            },
            {
              "ref": "Hos.8.7",
              "role": "defining",
              "note": "Grain that produces no head yields no flour."
            },
            {
              "ref": "Num.5.15",
              "role": "defining",
              "note": "Barley supplies the flour for the jealousy offering."
            },
            {
              "ref": "Gen.18.6",
              "role": "defining",
              "note": "Abraham asks Sarah to knead three measures of flour specified as fine."
            },
            {
              "ref": "1Ki.5.2",
              "role": "defining",
              "note": "Solomon’s daily provisions list fine flour and ordinary flour in separate quantities."
            },
            {
              "ref": "Jdg.6.19",
              "role": "defining",
              "note": "Gideon makes unleavened bread from an ephah of flour."
            },
            {
              "ref": "1Sa.28.24",
              "role": "defining",
              "note": "The woman kneads flour and bakes unleavened bread for Saul."
            },
            {
              "ref": "1Sa.1.24",
              "role": "defining",
              "note": "Hannah brings an ephah of flour to Shiloh."
            },
            {
              "ref": "2Sa.17.28",
              "role": "defining",
              "note": "Flour is listed separately from wheat and barley in the supplies for David."
            },
            {
              "ref": "1Ki.17.12",
              "role": "defining",
              "note": "The widow has only a handful of flour and a little oil."
            },
            {
              "ref": "1Ki.17.14",
              "role": "defining",
              "note": "Elijah promises that the flour in her jar will last until rain returns."
            },
            {
              "ref": "1Ki.17.16",
              "role": "defining",
              "note": "The flour in the jar lasts as Yahweh promised."
            },
            {
              "ref": "2Ki.4.41",
              "role": "defining",
              "note": "Elisha asks for flour and throws it into the pot of stew."
            },
            {
              "ref": "1Ch.12.41",
              "role": "defining",
              "note": "Flour is among the provisions brought for the gathering at Hebron."
            }
