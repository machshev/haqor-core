        {
          "id": "moth",
          "gloss": "moth",
          "definition": "An insect whose young eat holes in clothing.",
          "evidence": [
            {
              "ref": "Isa.50.9",
              "role": "defining",
              "note": "Those who condemn the speaker wear out like a garment eaten by a moth."
            },
            {
              "ref": "Isa.51.8",
              "role": "defining",
              "note": "The moth eats a garment, in parallel with the grub eating wool."
            },
            {
              "ref": "Hos.5.12",
              "role": "defining",
              "note": "Yahweh compares himself to a moth to Ephraim and to rot to Judah."
            },
            {
              "ref": "Psa.39.12",
              "role": "defining",
              "note": "Under divine rebuke a person’s treasured possession wastes away as if consumed by a moth."
            },
            {
              "ref": "Job.4.19",
              "role": "defining",
              "note": "Eliphaz invokes the moth in describing the frailty of those who dwell in houses of clay."
            },
            {
              "ref": "Job.13.28",
              "role": "defining",
              "note": "Job compares decay to a garment a moth has eaten."
            },
            {
              "ref": "Job.27.18",
              "role": "defining",
              "note": "The moth’s house and a watchman’s hut illustrate how precarious the house of the wicked is."
            }
