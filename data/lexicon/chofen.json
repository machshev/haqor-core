          "id": "handfuls",
          "gloss": "cupped hands, handfuls",
          "definition": "The hollows made by cupping the hands, or the amount they hold. The biblical forms refer to both hands.",
          "evidence": [
            {
              "ref": "Exo.9.8",
              "role": "defining",
              "note": "Moses and Aaron are told to take their hands full of furnace soot."
            },
            {
              "ref": "Lev.16.12",
              "role": "defining",
              "note": "The priest takes two handfuls of finely ground incense inside the veil, alongside a censer of coals."
            },
            {
              "ref": "Ezk.10.2",
              "role": "defining",
              "note": "The linen-clad man is instructed to fill his hands with burning coals."
            },
            {
              "ref": "Ezk.10.7",
              "role": "defining",
              "note": "A cherub places the coals into the man’s cupped hands."
            },
            {
              "ref": "Pro.30.4",
              "role": "defining",
              "note": "The question asks who could gather the wind into cupped hands."
            },
            {
              "ref": "Ecc.4.6",
              "role": "defining",
              "note": "One palm full with rest is weighed against two handfuls gained through toil."
            }
          ],
