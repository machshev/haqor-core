    {
      "ot": "Gen.3.15",
      "title": "The seed of the woman will bruise the serpent's head",
      "theme": "seed-of-woman",
      "messianic": true,
      "horizon": "both",
      "note": "The first promise: a son of a woman who would destroy sin's power, himself wounded in doing it.",
      "fulfilments": [
        { "ref": "Gal.4.4", "kind": "allusion", "note": "\"Made of a woman.\"" },
        { "ref": "Heb.2.14", "kind": "allusion", "note": "Through death he destroyed him that had the power of death." },
        { "ref": "1Jn.3.8", "kind": "allusion" },
        { "ref": "Rom.16.20", "kind": "allusion", "note": "Still to be completed: \"shall bruise Satan under your feet shortly.\"" }
      ]
    },
    {
      "ot": "Gen.12.1-3",
